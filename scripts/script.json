        ],
        [{ "lang": "en", "text": "And soon you too will miss yourself." }],
        [{ "lang": "en", "text": "The world." }],
        [{ "lang": "en", "text": "And everything in between." }],
        [{ "lang": "en", "text": "Yet it will always feel like you are already too late." }],
        [{ "lang": "en", "text": "..." }],
        [{ "lang": "en", "text": "Fin." }]
      ]
