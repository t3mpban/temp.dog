  "dialogue": [
    {
      "id": "pc-off",
      "lines": [[{ "lang": "en", "text": "Turn the PC on?" }]]
    },
    {
      "id": "pc-off-yes",
      "lines": [
        [{ "lang": "en", "text": "You turned the PC on" }],
        [{ "lang": "en", "text": "It's quieter than you thought." }]
      ]
    },
    {
      "id": "pc-off-no",
      "lines": [
        [{ "lang": "en", "text": "You feel weirdly powerful and in control" }],
        [{ "lang": "en", "text": "But I assure you, you're not." }]
      ]
    },
    {
      "id": "pc-on",
      "lines": [[{ "lang": "en", "text": "Turn the PC off?" }]]
    },
    {
      "id": "pc-on-yes",
      "lines": [[{ "lang": "en", "text": "You turned the PC off" }]]
    },
    {
      "id": "pc-on-no",
      "lines": [
        [
          {
            "lang": "en",
            "text": "You decided you like the ambient noise of the fans spinning and wanted to keep the PC on"
          }
        ]
      ]
    },
    {
      "id": "pc-ram",
      "lines": [
        [{ "lang": "en", "text": "..." }],
        [{ "lang": "en", "text": "No. Stealing is wrong." }],
        [{ "lang": "en", "text": "Shame on you." }],
        [{ "lang": "en", "text": "I know ram prices are high but come on..." }]
      ]
    },
    {
      "id": "mousepad",
      "lines": [
        [{ "lang": "en", "text": "It's a mouse pad" }],
        [{ "lang": "en", "text": "made out of glass" }],
        [{ "lang": "en", "text": "so its a glass pad." }]
      ]
    },
    {
      "id": "mouse",
      "lines": [
        [
          {
            "lang": "en",
            "text": "You notice the fact this mouse moves based on where your mouse is"
          }
        ],
        [
          {
            "lang": "en",
            "text": "but there's a small chance you have a track pad or using touch pad."
          }
        ],
        [{ "lang": "en", "text": "..." }],
        [{ "lang": "en", "text": "This is why we can't have nice things." }]
      ]
    },
    {
      "id": "keyboard",
      "lines": [
        [{ "lang": "en", "text": "It's a keyboard" }],
        [{ "lang": "en", "text": "Made out of magnets" }],
        [{ "lang": "en", "text": "It's a magnetic keyboard" }],
        [{ "lang": "en", "text": "You wonder why such a thing exists" }],
        [{ "lang": "en", "text": "Maybe it's something to do with global warming?" }]
      ]
    },
    {
      "id": "clock",
      "lines": [
        [{ "lang": "en", "text": "The time is {time}" }],
        [{ "lang": "en", "text": "in this timezone..." }]
      ]
    },
    {
      "id": "monitor-off",
      "lines": [[{ "lang": "en", "text": "The computer is turned off, and so is the monitor." }]]
    },
    {
      "id": "monitor2-off",
      "lines": [
        [
          {
            "lang": "en",
            "text": "You'd think a second monitor positioned in such a way would be meaningless..."
          }
        ]
      ]
    },
    {
      "id": "monitor2-on",
      "lines": [
        [{ "lang": "en", "text": "Even with the PC on, the second monitor is useless." }],
        [{ "lang": "en", "text": "..." }],
        [{ "lang": "en", "text": "It makes you feel better about yourself." }]
      ]
    },
    {
      "id": "chair-1",
      "lines": [[{ "lang": "en", "text": "It's a chair" }]]
    },
    {
      "id": "chair-2",
      "lines": [[{ "lang": "en", "text": "Seriously, it's a chair" }]]
    },
    {
      "id": "chair-3",
      "lines": [[{ "lang": "en", "text": "Do you not believe me?" }]]
    },
    {
      "id": "chair-4",
      "lines": [
        [{ "lang": "en", "text": "You-" }],
        [{ "lang": "en", "text": "why are you clicking on the chair" }]
      ]
    },
    {
      "id": "chair-5",
      "lines": [[{ "lang": "en", "text": "there's no achievement for this btw" }]]
    },
    {
      "id": "chair-6",
      "lines": [[{ "lang": "en", "text": "you're wasting your time" }]]
    },
    {
      "id": "chair-7",
      "lines": [[{ "lang": "en", "text": "..." }]]
    },
    {
      "id": "chair-8",
      "lines": [[{ "lang": "en", "text": "ok fine, leave me alone." }]]
    },
    {
      "id": "bed-busy-1",
      "lines": [[{ "lang": "en", "text": "Your job isn't done yet." }]]
    },
    {
      "id": "bed-busy-2",
      "lines": [[{ "lang": "en", "text": "You can't sleep now, you have a job to do." }]]
    },
    {
      "id": "bed-busy-3",
      "lines": [[{ "lang": "en", "text": "No, you must finish what you started." }]]
    },
    {
      "id": "bed-busy-4",
      "lines": [[{ "lang": "en", "text": "You can sleep when your finished." }]]
    },
    {
      "id": "plush-open-1",
      "lines": [[{ "lang": "en", "text": "You feel like it's watching you..." }]]
    },
    {
      "id": "plush-open-2",
      "lines": [[{ "lang": "en", "text": "You feel it's holding back..." }]]
    },
    {
      "id": "plush-open-3",
      "lines": [[{ "lang": "en", "text": "You feel an ominous presence..." }]]
    },
    {
      "id": "plush-open-4",
      "lines": [[{ "lang": "en", "text": "You feel like it could speak..." }]]
    },
    {
      "id": "plush-open-5",
      "lines": [[{ "lang": "en", "text": "You feel an overwhelming amount of pressure..." }]]
    },
    {
      "id": "plush-interact",
      "lines": [[{ "lang": "en", "text": "Interact with it?" }]]
    },
    {
      "id": "plush-topics",
      "lines": [[{ "lang": "en", "text": "..." }]]
    },
    {
      "id": "plush-password",
      "lines": [
        [{ "lang": "en", "text": "You ask the [Marketable Plush] what the password is" }],
        [{ "lang": "en", "text": "..." }],
        [
