  "dialogue": [
    {
      "id": "chair",
      "lines": [
        [
          { "lang": "en", "text": "It's a chair." },
          { "lang": "es", "text": "Es una silla." },
          { "lang": "pt", "text": "É uma cadeira." },
          { "lang": "fr", "text": "C'est une chaise." },
          { "lang": "de", "text": "Es ist ein Stuhl." },
          { "lang": "jp", "text": "ただの椅子だ。" },
          { "lang": "kr", "text": "그냥 의자네." },
          { "lang": "zh", "text": "这是一把椅子。" }
        ],
        [
          { "lang": "en", "text": "Nothing special about it, really." },
          { "lang": "es", "text": "Nada especial, la verdad." },
          { "lang": "pt", "text": "Nada de especial, na verdade." },
          { "lang": "fr", "text": "Rien de spécial, vraiment." },
          { "lang": "de", "text": "Nichts Besonderes, ehrlich." },
          { "lang": "jp", "text": "特に、何もないよ。" },
          { "lang": "kr", "text": "딱히, 특별할 건 없어." },
          { "lang": "zh", "text": "其实，没什么特别的。" }
        ],
        [
          { "lang": "en", "text": "...why are you still looking at it?" },
          { "lang": "es", "text": "...¿por qué sigues mirándola?" },
          { "lang": "pt", "text": "...por que ainda está olhando?" },
          { "lang": "fr", "text": "...pourquoi tu la regardes encore ?" },
          { "lang": "de", "text": "...warum schaust du noch hin?" },
          { "lang": "jp", "text": "…まだ見てるの？" },
          { "lang": "kr", "text": "…아직도 보고 있어?" },
          { "lang": "zh", "text": "……你怎么还在看它？" }
        ]
      ]
    }
  ],
